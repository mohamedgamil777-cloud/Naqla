{
  "name": "naqla",
  "version": "0.1.0",
  "private": true,
  "description": "Naqla — Arabic-first pickup & van rental platform for Egypt",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --conditions=react-server --tsconfig tsconfig.json db/seeds/seed.ts",
    "db:seed:admin": "tsx --env-file-if-exists=.env.local --conditions=react-server --tsconfig tsconfig.json db/seeds/seed-admin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.6.1",
    "jose": "^5.9.6",
    "next": "15.5.28",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
