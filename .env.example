# Naqla — server environment variables (Vercel → Project → Settings → Environment Variables).
# Validated at startup by lib/env.ts. In production the server REFUSES TO START if
# DATABASE_URL is missing or AUTH_SECRET is missing/weak. Never commit real values.

# REQUIRED in production. Supabase → Project → Settings → Database → Connection string → "Transaction pooler".
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave empty locally to use the seeded in-memory store (development/tests only).
DATABASE_URL=

# REQUIRED in production: random string, 32+ characters. Signs website + mobile app logins.
# Changing it signs everyone out (web and app). Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
AUTH_SECRET=

# Admin emergency passcode (/admin-login → «دخول احتياطي»). Staff normally use their own phone + password.
# In production it must be 8+ characters and not the old public default, otherwise it is refused.
ADMIN_PASSCODE=

# First super-admin — created when the server starts if that phone has no password yet, so the team is
# never locked out after a deploy. Never overwrites an existing password; a customer who already chose
# their own password is never promoted. Set these in Vercel only (never commit them).
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=المدير العام

# SMS adapter. Login uses phone + password; OTP is switched off for now and returns later as a
# second factor. Unknown names are rejected at startup.
# SMS_PROVIDER=console

# Optional public defaults (admin → محتوى التطبيق overrides them).
# NEXT_PUBLIC_SUPPORT_PHONE=
# NEXT_PUBLIC_WHATSAPP=
